# ============================================================
# YT Channel Hub — Environment Variables
# Copy this file to ".env.local" and fill in your real values.
# ".env.local" is git-ignored, so your secrets stay private.
# ============================================================

# --- Contact links (required) ---------------------------------
# Used everywhere the site shows a WhatsApp / Telegram button.
# Format for WhatsApp: https://wa.me/<country code + number, no + or spaces>
# Format for Telegram:  https://t.me/<username>
NEXT_PUBLIC_WHATSAPP_LINK=https://wa.me/923007917283
NEXT_PUBLIC_TELEGRAM_LINK=https://t.me/waqas_aziz

# --- Authentication (optional — fill in when you connect a backend) ---
# This project ships with a placeholder auth layer (see lib/auth.js)
# that stores accounts in the browser only, so Sign Up / Login work
# for local testing but are NOT real accounts. To go live, pick ONE
# of the providers below, install its SDK, and follow the matching
# TODO block inside lib/auth.js.

# Option A — NextAuth.js (recommended for Next.js)
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=replace-with-a-random-string
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Option B — Supabase
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Option C — Firebase
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Database (optional — only if you add real channel inventory later) ---
# DATABASE_URL=
